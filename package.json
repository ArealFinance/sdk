{
  "name": "@areal/sdk",
  "version": "0.1.0",
  "description": "Areal Finance product SDK (TypeScript) — typed bindings for the 5 on-chain programs, built on @arlex/client",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": ["dist", "idl", "overrides", "README.md", "LICENSE"],
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.mjs", "require": "./dist/index.js" },
    "./native-dex": { "types": "./dist/programs/native-dex/index.d.ts", "import": "./dist/programs/native-dex/index.mjs", "require": "./dist/programs/native-dex/index.js" },
    "./ownership-token": { "types": "./dist/programs/ownership-token/index.d.ts", "import": "./dist/programs/ownership-token/index.mjs", "require": "./dist/programs/ownership-token/index.js" },
    "./rwt-engine": { "types": "./dist/programs/rwt-engine/index.d.ts", "import": "./dist/programs/rwt-engine/index.mjs", "require": "./dist/programs/rwt-engine/index.js" },
    "./yield-distribution": { "types": "./dist/programs/yield-distribution/index.d.ts", "import": "./dist/programs/yield-distribution/index.mjs", "require": "./dist/programs/yield-distribution/index.js" },
    "./futarchy": { "types": "./dist/programs/futarchy/index.d.ts", "import": "./dist/programs/futarchy/index.mjs", "require": "./dist/programs/futarchy/index.js" },
    "./pda": { "types": "./dist/pda/index.d.ts", "import": "./dist/pda/index.mjs", "require": "./dist/pda/index.js" },
    "./tx": { "types": "./dist/tx/index.d.ts", "import": "./dist/tx/index.mjs", "require": "./dist/tx/index.js" },
    "./network": { "types": "./dist/network/index.d.ts", "import": "./dist/network/index.mjs", "require": "./dist/network/index.js" },
    "./errors": { "types": "./dist/errors/index.d.ts", "import": "./dist/errors/index.mjs", "require": "./dist/errors/index.js" },
    "./idl/*.json": "./idl/*.json"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "codegen": "node scripts/codegen.mjs"
  },
  "peerDependencies": {
    "@arlex/client": "^0.2.0",
    "@solana/web3.js": "^1.95.0"
  },
  "devDependencies": {
    "@arlex/client": "file:../vendor/arlex-client-0.2.1.tgz",
    "@solana/web3.js": "^1.98.0",
    "@types/node": "^20.11.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
